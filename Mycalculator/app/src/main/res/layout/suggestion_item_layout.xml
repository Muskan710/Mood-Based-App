<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title Bar -->
        <TextView
            android:id="@+id/tvSuggestionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_calculate"
            android:padding="16dp"
            android:text="Productivity Suggestions"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:layout_marginBottom="10dp"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F4FF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvEnergyLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You have moderate energy today. Try:"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/suggestionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Close Button -->
        <Button
            android:id="@+id/btnClosesuggestions"
            android:layout_width="350dp"
            android:layout_marginStart="15dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/button_calculate"
            android:padding="16dp"
            android:text="Close"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>